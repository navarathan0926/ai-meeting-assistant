# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── PostgreSQL ───────────────────────────────────────────────
# Credentials below are used for both local dev and Docker Compose.
# - Local dev (npm run start:dev): keep DB_HOST=localhost
# - Docker Compose: DB_HOST is overridden to host.docker.internal automatically
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=meeting_assistant

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_GPT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4o

# ─── Jira (Phase 8) ───────────────────────────────────────────
JIRA_API_GATEWAY_URL=https://api.atlassian.com/ex/jira
CLOUD_ID=your-atlassian-cloud-id
JIRA_API_KEY=your-jira-api-token
JIRA_EMAIL=your-atlassian-account-email
JIRA_PROJECT_KEY=PROJ
# Optional: used to build browse links in the UI
JIRA_BASE_URL=https://your-domain.atlassian.net

# ─── Azure Blob Storage ───────────────────────────────────────
# Storage option A (recommended for local dev): Connection string
AZURE_STORAGE_CONNECTION_STRING=
# Storage option B: Explicit account credentials (useful when generating SAS)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Blob container where audio uploads are stored
# Preferred:
AZURE_STORAGE_CONTAINER_NAME=uploads
# Backwards-compatible alias (also supported):
AZURE_STORAGE_CONTAINER=uploads

# If your backend generates signed URLs, it will typically use SAS.
# Set a default expiry (in minutes) for generated SAS URLs.
AZURE_BLOB_SAS_EXPIRES_IN_MINUTES=60

CLIENT_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─── Redis (BullMQ queue backend) ────────────────────────────
# Local development (Docker Compose): use the service name as host
REDIS_URL=redis://redis:6379
# For running outside Docker (e.g. host machine):
# REDIS_URL=redis://localhost:6379
# Upstash (production / Azure deployment) — TLS required:
# REDIS_URL=rediss://default:<password>@<your-db>.upstash.io:6379

