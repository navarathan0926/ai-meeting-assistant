# Copy to .env.e2e for local Playwright runs (never commit .env.e2e).
#
# GitHub Actions: add the same values as repository secrets instead.

# Deployed web app URL (no trailing slash)
PLAYWRIGHT_BASE_URL=https://your-web-app.azurecontainerapps.io

# Dedicated E2E account — use email/password login (not Google OAuth).
# Settings flow requires ADMIN role; USER role can run login/dashboard/logout only.
E2E_TEST_EMAIL=e2e-test@example.com
E2E_TEST_PASSWORD=replace-with-a-strong-password
